
/* =========================================================
   VITOR HUGO FREITAS — PORTFÓLIO REACT
   Tema: Dark Premium
   ========================================================= */

/* 1. Variáveis e configurações globais
   ========================================================= */

:root {
  --bg: #0a0b0e;
  --surface: #111318;
  --surface-2: #171a20;
  --line: rgba(255, 255, 255, 0.1);
  --text: #f0f0ec;
  --muted: #9a9da6;
  --accent: #c6f277;
  --font: "Manrope", sans-serif;
  --mono: "DM Mono", monospace;
  --max: 1200px;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 90px;
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: var(--font);
  -webkit-font-smoothing: antialiased;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  font: inherit;
}

::selection {
  color: var(--bg);
  background: var(--accent);
}

h1,
h2,
h3,
p {
  margin-top: 0;
}

/* 2. Textura de fundo
   ========================================================= */

.noise {
  position: fixed;
  inset: 0;
  z-index: 10;
  pointer-events: none;
  opacity: 0.035;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.7'/%3E%3C/svg%3E");
}

.section-shell {
  width: min(var(--max), calc(100% - 64px));
  margin-inline: auto;
}

/* 3. Cabeçalho e navegação
   ========================================================= */

.site-header {
  position: relative;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: min(var(--max), calc(100% - 64px));
  height: 94px;
  margin: auto;
  border-bottom: 1px solid var(--line);
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 12px;
}


/* Marca VH: hexágono */

.brand-mark {
  position: relative;
  isolation: isolate;

  display: grid;
  place-items: center;

  width: 42px;
  height: 42px;

  border: none;
  border-radius: 0;
  background: transparent;

  color: var(--text);
  font-size: 14px;
  font-weight: 800;
  letter-spacing: -1px;
}

/* Contorno externo */
.brand-mark::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -2;

  background: rgba(198, 242, 119, 0.7);

  clip-path: polygon(
    25% 0%,
    75% 0%,
    100% 50%,
    75% 100%,
    25% 100%,
    0% 50%
  );
}

/* Interior escuro, sem quadrado aparente */
.brand-mark::after {
  content: "";
  position: absolute;
  inset: 1px;
  z-index: -1;

  background: var(--bg);

  clip-path: polygon(
    25% 0%,
    75% 0%,
    100% 50%,
    75% 100%,
    25% 100%,
    0% 50%
  );
}

.brand-mark span {
  color: var(--accent);
}

.brand-name {
  font-size: 11px;
  line-height: 1.5;
  font-weight: 800;
  letter-spacing: 0.09em;
}

.brand-name small {
  color: var(--muted);
  font-family: var(--mono);
  font-size: 8px;
  font-weight: 400;
  letter-spacing: 0.05em;
}

.nav {
  display: flex;
  align-items: center;
  gap: 34px;
  color: #c5c6c9;
  font-size: 12px;
}

.nav a {
  transition: color 0.2s;
}

.nav a:hover,
.text-link:hover {
  color: var(--accent);
}

.nav-contact {
  padding: 12px 15px;
  border: 1px solid var(--line);
  border-radius: 3px;
  color: var(--text) !important;
}

.nav-contact span {
  margin-left: 10px;
  color: var(--accent);
}

.menu-toggle {
  display: none;
}

/* 4. Elementos compartilhados
   ========================================================= */

.eyebrow {
  margin: 0 0 24px;
  color: var(--muted);
  font: 10px var(--mono);
  letter-spacing: 0.13em;
}

.status-dot {
  display: inline-block;
  width: 7px;
  height: 7px;
  margin-right: 8px;
  background: var(--accent);
  border-radius: 50%;
  box-shadow: 0 0 14px #c6f27766;
}

h1 span,
h2 span {
  color: var(--accent);
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 28px;
  min-height: 48px;
  padding: 0 18px;
  border-radius: 3px;
  font-size: 11px;
  font-weight: 800;
  transition: transform 0.2s, background 0.2s;
}

.button:hover {
  transform: translateY(-2px);
}

.button-primary {
  background: var(--accent);
  color: #12150d;
}

.button-primary:hover {
  background: #d6ff91;
}

.button span {
  font-size: 17px;
  font-weight: 400;
}

.text-link {
  color: #dededb;
  font-size: 11px;
  transition: color 0.2s;
}

.text-link span {
  margin-left: 8px;
  color: var(--accent);
}

/* 5. Hero — apresentação inicial
   ========================================================= */

.hero {
  position: relative;
  display: grid;
  grid-template-columns: 1.05fr 0.95fr;
  align-items: center;
  min-height: 670px;
  padding-top: 60px;
  padding-bottom: 100px;
}

.hero-copy {
  position: relative;
  z-index: 2;
  padding-bottom: 10px;
}

.hero h1 {
  margin-bottom: 25px;
  font-size: clamp(42px, 5.1vw, 70px);
  font-weight: 600;
  line-height: 1.08;
  letter-spacing: -0.065em;
}

.hero-description {
  max-width: 470px;
  margin-bottom: 30px;
  color: #a6a8ae;
  font-size: 14px;
  line-height: 1.9;
}

.hero-actions,
.contact-actions {
  display: flex;
  align-items: center;
  gap: 25px;
  flex-wrap: wrap;
}

.hero-meta {
  display: flex;
  gap: 35px;
  margin-top: 60px;
}

.hero-meta div {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  color: #92959d;
  font-size: 10px;
  line-height: 1.6;
}

.meta-number {
  color: var(--accent);
  font: 10px var(--mono);
}

/* 6. Hero — composição visual */

.hero-visual {
  position: relative;
  display: grid;
  place-items: center;
  height: 460px;
  isolation: isolate;
}

.hero-visual::before {
  position: absolute;
  width: 360px;
  height: 360px;
  border-radius: 50%;
  background: radial-gradient(
    circle,
    #c6f2771c,
    transparent 68%
  );
  content: "";
}

.visual-orbit {
  position: absolute;
  border: 1px solid #c6f27729;
  border-radius: 50%;
  transform: rotate(-28deg);
}

.orbit-one {
  width: 390px;
  height: 240px;
}

.orbit-two {
  width: 310px;
  height: 420px;
  border-color: #ffffff17;
  transform: rotate(44deg);
}

.visual-core {
  position: relative;
  display: grid;
  place-items: center;
  width: 165px;
  height: 165px;
  border: 1px solid #c6f27773;
  border-radius: 50%;
  background: radial-gradient(
    circle at 30% 25%,
    #282d27,
    #11140f 70%
  );
  box-shadow:
    0 0 80px #c6f27714,
    inset 0 0 30px #c6f2770f;
}

.visual-core span {
  font-size: 46px;
  font-weight: 800;
  letter-spacing: -0.1em;
}

.visual-core i {
  position: absolute;
  top: 27px;
  right: 19px;
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 20px var(--accent);
}

.float-card {
  position: absolute;
  border: 1px solid #ffffff1f;
  background: #14161aeb;
  box-shadow: 0 20px 60px #0005;
  backdrop-filter: blur(10px);
}

.card-top {
  top: 53px;
  right: 3px;
  width: 180px;
  padding: 17px;
  transform: rotate(3deg);
}

.mini-label {
  display: block;
  margin-bottom: 13px;
  color: var(--accent);
  font: 8px var(--mono);
  letter-spacing: 0.1em;
}

.card-top strong {
  font-size: 16px;
  line-height: 1.35;
  letter-spacing: -0.04em;
}

.card-line {
  display: block;
  width: 42px;
  height: 2px;
  margin-top: 18px;
  background: var(--accent);
}

.card-bottom {
  position: absolute;
  bottom: 53px;
  left: -1px;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px;
  color: #c3c5c8;
  font: 8px var(--mono);
  transform: rotate(-3deg);
}

.card-bottom b {
  color: var(--accent);
  font-weight: 400;
}

.pulse-bars {
  display: flex;
  align-items: end;
  gap: 3px;
  height: 20px;
}

.pulse-bars i {
  display: block;
  width: 3px;
  background: var(--accent);
}

.pulse-bars i:nth-child(1) { height: 7px; }
.pulse-bars i:nth-child(2) { height: 13px; }
.pulse-bars i:nth-child(3) { height: 18px; }
.pulse-bars i:nth-child(4) { height: 10px; }
.pulse-bars i:nth-child(5) { height: 15px; }

.visual-index {
  position: absolute;
  right: 0;
  bottom: 9px;
  color: #5f626a;
  font: 8px var(--mono);
  letter-spacing: 0.12em;
}

.scroll-cue {
  position: absolute;
  bottom: 29px;
  left: 0;
  display: flex;
  align-items: center;
  gap: 12px;
  color: #71747c;
  font: 8px var(--mono);
  letter-spacing: 0.12em;
}

.scroll-cue span {
  width: 28px;
  height: 1px;
  background: var(--accent);
}

/* 7. Introdução
   ========================================================= */

.intro {
  display: grid;
  grid-template-columns: 0.42fr 1fr;
  gap: 40px;
  padding-top: 120px;
  padding-bottom: 135px;
  border-top: 1px solid var(--line);
}

.intro .eyebrow {
  padding-top: 9px;
}

.intro-content {
  display: grid;
  grid-template-columns: 1.3fr 0.7fr;
  align-items: end;
  gap: 50px;
}

.intro h2,
.section-heading h2,
.design-copy h2,
.contact h2 {
  margin: 0;
  font-size: clamp(30px, 3.8vw, 49px);
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: -0.06em;
}

.intro-content > p {
  margin: 0;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.9;
}

/* 8. Projetos
   ========================================================= */

.projects {
  padding-bottom: 130px;
}

.section-heading {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 45px;
  margin-bottom: 45px;
}

.section-heading .eyebrow {
  margin-bottom: 17px;
}

.section-heading > p {
  max-width: 310px;
  margin-bottom: 4px;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.8;
}

.project-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: start;
  gap: 20px;
}

.project-card {
  min-width: 0;
  border: 1px solid var(--line);
  background: #0d0f12;
  transition: border-color 0.25s, transform 0.25s;
}

.project-card:hover {
  border-color: #c6f2775c;
  transform: translateY(-3px);
}

.project-featured {
  display: grid;
  grid-column: 1 / -1;
  grid-template-columns: 1.15fr 0.85fr;
}

.project-art {
  position: relative;
  display: grid;
  place-items: center;
  min-height: 300px;
  padding: 27px;
  overflow: hidden;
}

.project-featured .project-art {
  min-height: 340px;
}

.nexus-art {
  background: radial-gradient(
    ellipse at 50% 40%,
    #283026,
    #14171a 60%,
    #101114
  );
}

/* Mockup do Nexus Dashboard */

.mock-window {
  width: 100%;
  max-width: 530px;
  overflow: hidden;
  border: 1px solid #454b45;
  border-radius: 7px;
  background: #101310;
  box-shadow: 0 25px 50px #0006;
  transform: perspective(1000px) rotateY(-5deg) rotateX(2deg);
}

.mock-top {
  display: flex;
  align-items: center;
  gap: 5px;
  height: 30px;
  padding: 0 10px;
  border-bottom: 1px solid #292d29;
}

.mock-top > span {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #62675f;
}

.mock-top small {
  margin-left: 10px;
  color: #a7b49b;
  font: 7px var(--mono);
  letter-spacing: 0.1em;
}

.mock-body {
  display: flex;
  min-height: 215px;
}

.mock-sidebar {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 17px;
  width: 42px;
  padding: 13px 0;
  border-right: 1px solid #292d29;
  color: #6c7668;
}

.mock-sidebar b {
  color: var(--accent);
  font-size: 12px;
}

.mock-sidebar i {
  width: 12px;
  height: 12px;
  border: 1px solid #50594b;
  border-radius: 3px;
}

.mock-dashboard {
  flex: 1;
  min-width: 0;
  padding: 16px;
}

.mock-welcome {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.mock-welcome small,
.chart-label small {
  color: #7d8978;
  font: 7px var(--mono);
}

.mock-welcome b {
  font-size: 14px;
  font-weight: 600;
}

.mock-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 7px;
  margin-top: 14px;
}

.mock-stats div {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 8px;
  border: 1px solid #2a3426;
  background: #1b211a;
}

.mock-stats small {
  color: #8b9585;
  font-size: 7px;
}

.mock-stats b {
  font-size: 13px;
}

.mock-stats i {
  color: var(--accent);
  font: 7px var(--mono);
  font-style: normal;
}

.mock-chart {
  margin-top: 10px;
  padding: 10px;
  border: 1px solid #262d23;
  background: #151a14;
}

.chart-label {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  font-size: 8px;
}

.chart-bars {
  display: flex;
  align-items: end;
  gap: 7px;
  height: 57px;
  padding: 8px 5px 0;
  border-bottom: 1px solid #3a4335;
}

.chart-bars i {
  flex: 1;
  border-radius: 2px 2px 0 0;
  background: linear-gradient(#c6f277, #668b3b);
  opacity: 0.8;
}

.art-caption {
  position: absolute;
  bottom: 13px;
  left: 17px;
  color: #ffffff7a;
  font: 7px var(--mono);
  letter-spacing: 0.1em;
}

/* Informações dos projetos */

.project-info {
  position: relative;
  padding: 25px;
}

.project-featured .project-info {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 35px;
}

.project-type {
  display: block;
  margin-bottom: 11px;
  color: var(--accent);
  font: 8px var(--mono);
  letter-spacing: 0.1em;
}

.project-info h3 {
  margin-bottom: 15px;
  font-size: 23px;
  letter-spacing: -0.05em;
}

.project-number {
  position: absolute;
  top: 25px;
  right: 25px;
  color: #696d74;
  font: 10px var(--mono);
}

.project-info p {
  max-width: 450px;
  margin-bottom: 20px;
  color: var(--muted);
  font-size: 11px;
  line-height: 1.9;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.tag-list span {
  padding: 7px 9px;
  border: 1px solid var(--line);
  border-radius: 2px;
  color: #b7b9bf;
  font: 8px var(--mono);
}

/* Jaguar */

.jaguar-art {
  min-height: 260px;
  background: radial-gradient(
    ellipse at 50% 35%,
    #25272f,
    #111217 68%
  );
}

.jaguar-panel {
  display: flex;
  width: 100%;
  max-width: 440px;
  min-height: 220px;
  overflow: hidden;
  border: 1px solid #383943;
  border-radius: 6px;
  background: #14151b;
  box-shadow: 0 20px 45px #0005;
  transform: rotate(-2deg);
}

.jaguar-sidebar {
  flex-shrink: 0;
  width: 112px;
  padding: 12px 8px;
  border-right: 1px solid #2d2e38;
  background: #191a21;
  color: #9294a0;
  font-size: 7px;
}

.jaguar-symbol {
  margin: 0 0 18px 5px;
  color: white;
  font-size: 17px;
  font-weight: 800;
}

.jaguar-symbol span {
  color: #d8a7ff;
}

.jaguar-sidebar > div:not(.jaguar-symbol):not(.side-user) {
  margin-bottom: 4px;
  padding: 8px 5px;
}

.jaguar-sidebar b {
  margin-left: 4px;
  font-weight: 500;
}

.jaguar-sidebar .side-active {
  border-radius: 3px;
  background: #33283f;
  color: #e3c5ff;
}

.side-user {
  display: flex;
  align-items: center;
  gap: 5px;
  margin-top: 24px;
  padding: 12px 2px 6px;
  border-top: 1px solid #30313a;
  font-size: 6px;
}

.side-user > span {
  display: grid;
  place-items: center;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: #454050;
  color: white;
}

.side-user small {
  color: #777a87;
  line-height: 1.5;
}

.side-user b {
  color: #e6e5e9;
}

.jaguar-content {
  flex: 1;
  min-width: 0;
  padding: 17px 12px;
}

.jaguar-content > small {
  color: #8b8e9c;
  font: 6px var(--mono);
  letter-spacing: 0.08em;
}

.jaguar-content h4 {
  margin: 9px 0 12px;
  font-size: 13px;
  letter-spacing: -0.04em;
}

.jaguar-search {
  margin-bottom: 9px;
  padding: 7px;
  border: 1px solid #333541;
  border-radius: 3px;
  color: #858895;
  font-size: 8px;
}

.jaguar-search span {
  margin-left: 5px;
}

.file-row {
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 8px 0;
  border-bottom: 1px solid #2a2b34;
}

.file-icon {
  display: grid;
  place-items: center;
  flex-shrink: 0;
  width: 24px;
  height: 27px;
  border-radius: 3px;
  background: #472d32;
  color: #ffb0b8;
  font: 6px var(--mono);
}

.file-icon.green {
  background: #253d31;
  color: #a3e5b7;
}

.file-icon.purple {
  background: #342b49;
  color: #d2b6ff;
}

.file-row > span:nth-child(2) {
  display: flex;
  flex-direction: column;
  gap: 4px;
  min-width: 0;
}

.file-row b {
  font-size: 7px;
  font-weight: 600;
}

.file-row small {
  color: #777a87;
  font-size: 6px;
}

.file-row i {
  margin-left: auto;
  color: #747784;
  font-size: 8px;
}

/* Loja / e-commerce */

.commerce-art {
  min-height: 260px;
  padding: 19px;
  background: #d9d0bd;
  color: #282a24;
}

.shop-window {
  width: 100%;
  max-width: 440px;
  overflow: hidden;
  background: #f0e9dc;
  box-shadow: 0 15px 30px #0002;
  transform: rotate(2deg);
}

.shop-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 26px;
  padding: 0 9px;
  border-bottom: 1px solid #c9c0b1;
  font-size: 6px;
  letter-spacing: 0.04em;
}

.shop-nav span {
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 0.14em;
}

.shop-nav small {
  font-size: 5px;
}

.shop-nav b {
  font-size: 6px;
}

.shop-hero {
  position: relative;
  display: grid;
  grid-template-columns: 1fr 0.85fr;
  min-height: 140px;
  padding: 17px 15px 8px;
  overflow: hidden;
  background: #e5d5c1;
}

.shop-hero > div:first-child {
  position: relative;
  z-index: 2;
}

.shop-hero small {
  display: block;
  margin-bottom: 10px;
  font: 6px var(--mono);
  letter-spacing: 0.1em;
}

.shop-hero strong {
  display: block;
  font-family: Georgia, serif;
  font-size: 26px;
  font-weight: 400;
  line-height: 0.98;
  letter-spacing: -0.06em;
}

.shop-hero span {
  display: block;
  margin-top: 8px;
  font-size: 6px;
}

.shop-hero em {
  display: inline-block;
  margin-top: 12px;
  padding-bottom: 3px;
  border-bottom: 1px solid #36372e;
  font: normal 6px var(--mono);
}

.fashion-shape {
  position: relative;
}

.shape-sun {
  position: absolute;
  top: 0;
  right: 5px;
  width: 65px;
  height: 65px;
  border-radius: 50%;
  background: #b5a17d;
}

.shape-body {
  position: absolute;
  top: 38px;
  right: 15px;
  width: 63px;
  height: 95px;
  border-radius: 24px 24px 8px 8px;
  background: #333e32;
  clip-path: polygon(
    20% 0, 40% 0, 50% 16%, 60% 0,
    80% 0, 100% 36%, 78% 47%, 75% 100%,
    25% 100%, 22% 47%, 0 36%
  );
}

.shape-wave {
  position: absolute;
  right: -22px;
  bottom: -23px;
  width: 120px;
  height: 55px;
  border-top: 2px solid #9a7158;
  border-radius: 50%;
  transform: rotate(-25deg);
}

.shop-products {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
  padding: 10px;
}

.shop-products > div {
  min-width: 0;
}

.shop-products small {
  display: block;
  margin-top: 5px;
