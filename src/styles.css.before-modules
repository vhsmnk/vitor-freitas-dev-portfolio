/* 16. Acessibilidade: movimento reduzido
   ========================================================= */

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
  }
}


/* =========================================
   HERO — ANIMAÇÕES DE ENTRADA
========================================= */

/* Fade subindo */
@keyframes heroFadeUp {
  from {
    opacity: 0;
    transform: translateY(28px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Cursor do efeito de digitação */
@keyframes typingCursor {
  50% {
    border-color: transparent;
  }
}

/* Entrada suave do conteúdo */
.hero-copy > .eyebrow {
  animation: heroFadeUp 0.8s ease-out both;
  animation-delay: 0.1s;
}

.hero h1 {
  animation: heroFadeUp 0.9s ease-out both;
  animation-delay: 0.25s;
}

.hero-description {
  animation: heroFadeUp 0.8s ease-out both;
  animation-delay: 0.45s;
}

.hero-actions {
  animation: heroFadeUp 0.8s ease-out both;
  animation-delay: 0.6s;
}

.hero-meta {
  animation: heroFadeUp 0.8s ease-out both;
  animation-delay: 0.75s;
}

/* Composição visual à direita */
.hero-visual {
  animation: heroFadeUp 1.1s ease-out both;
  animation-delay: 0.35s;
}

/* Acessibilidade */
@media (prefers-reduced-motion: reduce) {
  .hero-copy > .eyebrow,
  .hero h1,
  .hero-description,
  .hero-actions,
  .hero-meta,
  .hero-visual {
    animation: none !important;
    opacity: 1;
    transform: none;
  }
}


/* =========================================
   HERO — DIGITAÇÃO E FADE-UP
========================================= */

@keyframes heroFadeUp {
  from {
    opacity: 0;
    translate: 0 24px;
  }

  to {
    opacity: 1;
    translate: 0 0;
  }
}

@keyframes cursorBlink {
  0%,
  49% {
    opacity: 1;
  }

  50%,
  100% {
    opacity: 0;
  }
}

/* Entrada escalonada do conteúdo */

.hero-copy > .eyebrow {
  animation: heroFadeUp 0.8s ease-out 0.1s both;
}

.hero-title {
  animation: heroFadeUp 0.8s ease-out 0.2s both;
}

.hero-description {
  animation: heroFadeUp 0.8s ease-out 0.45s both;
}

.hero-actions {
  animation: heroFadeUp 0.8s ease-out 0.6s both;
}

.hero-meta {
  animation: heroFadeUp 0.8s ease-out 0.75s both;
}

/* Composição visual à direita */

.hero-visual {
  animation: heroFadeUp 1s ease-out 0.35s both;
}

/* Destaque do título */

.hero-title-accent {
  color: var(--accent);
}

/* Cursor verde durante a digitação */

.typing-cursor {
  display: inline-block;
  width: 3px;
  height: 0.82em;
  margin-left: 5px;
  vertical-align: baseline;
  background: var(--accent);
  animation: cursorBlink 0.8s steps(1) infinite;
}

/* Acessibilidade */

@media (prefers-reduced-motion: reduce) {
  .hero-copy > .eyebrow,
  .hero-title,
  .hero-description,
  .hero-actions,
  .hero-meta,
  .hero-visual {
    animation: none !important;
    opacity: 1;
    translate: none;
  }

  .typing-cursor {
    display: none;
  }
}