}

.product-blob {
  position: relative;
  display: block;
  height: 52px;
  overflow: hidden;
  background: #c3b19a;
}

.blob-one {
  background: #b4a08b;
}

.blob-one::after {
  position: absolute;
  top: 5px;
  left: calc(50% - 17px);
  width: 34px;
  height: 34px;
  border: 6px solid #394537;
  border-top-color: transparent;
  border-radius: 12px 12px 18px 18px;
  content: "";
}

.blob-two {
  background: #c9bda7;
}

.blob-two::after {
  position: absolute;
  top: 5px;
  left: calc(50% - 15px);
  width: 31px;
  height: 45px;
  border-radius: 14px 14px 8px 8px;
  background: #e6ddd0;
  clip-path: polygon(
    20% 0, 40% 0, 50% 18%, 60% 0,
    80% 0, 100% 40%, 75% 50%, 75% 100%,
    25% 100%, 25% 50%, 0 40%
  );
  content: "";
}

.blob-three {
  background: #d1c4b0;
}

.blob-three::after {
  position: absolute;
  top: 12px;
  left: calc(50% - 17px);
  width: 35px;
  height: 35px;
  border: 5px solid #77594a;
  border-bottom: 0;
